# --- Runtime ---
# Multiplayer storage backend: "supabase" for production, "sqlite" for local dev/tests.
MULTIPLAYER_STORE=sqlite
SQLITE_DB_PATH=.data/lingo-karogs.db

# --- Supabase (durable online multiplayer in production) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Test-only hooks (NEVER set in production) ---
ALLOW_TEST_SETUP=
