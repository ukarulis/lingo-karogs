# --- Runtime ---
# Multiplayer storage backend for Karogs: "supabase" for production, "sqlite" locally.
MULTIPLAYER_STORE=sqlite
SQLITE_DB_PATH=.data/lingo-karogs.db

# --- Lingo multiplayer backend ---
# "postgres" (recommended production), "supabase", "sqlite" (local/tests),
# or "disabled". Production must never fall back silently.
LINGO_MP_STORE=sqlite
# PostgreSQL connection string for LINGO_MP_STORE=postgres (pooled URL).
LINGO_MP_DATABASE_URL=
# Path to the DigitalOcean project CA bundle (committed; not a secret).
LINGO_MP_SSL_CA_FILE=certs/digitalocean-ca.crt
# Connection pool size for serverless instances (conservative).
LINGO_MP_POOL_MAX=3
# Set to "disable" ONLY for local development; production always verifies TLS.
LINGO_MP_SSL=
# Required in production (>=16 chars); multiplayer fails closed without it.
PLAYER_TOKEN_SALT=
# Protects the operator diagnostics endpoint /api/lingo-mp/health.
OPERATOR_HEALTH_KEY=
# Optional operator-tunable limits (defaults: create 30/h, join 60/h).
LINGO_MP_CREATE_LIMIT=
LINGO_MP_JOIN_LIMIT=

# --- Supabase (Karogs online multiplayer in production) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Test-only hooks (NEVER set in production) ---
ALLOW_TEST_SETUP=
